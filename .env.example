# Generar valores locales con scripts/setup-local.sh. No usar este archivo como secretos reales.
POSTGRES_PASSWORD=GENERAR
ODIN_DATABASE_URL=postgresql+psycopg://odin:GENERAR@db:5432/odin
ODIN_MASTER_KEY_FILE=/run/secrets/master.key
ODIN_ORIGIN=http://localhost:8080
ODIN_SECURE_COOKIES=false
ODIN_WEB_PORT=8080
# Cartografía opcional; si cambias de proveedor, adapta CSP y atribución.
ODIN_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Sondeos ICMP independientes: concurrencia y máximo de IPs autorizadas activas.
ODIN_PROBE_CONCURRENCY=24
ODIN_PROBE_MAX_ADDRESSES=256

# Trazas (mtr) en paralelo; cada una dura unos 10 segundos.
ODIN_TRACE_CONCURRENCY=4

# Publicación WAN sin dominio (compose.wan.yaml): IP pública del servidor y puerto HTTPS.
#ODIN_WAN_HOST=203.0.113.10
#ODIN_WAN_PORT=8090
# Redes que pueden abrir el panel, separadas por espacio; por defecto, todas.
#ODIN_WAN_ALLOW=203.0.113.0/24
